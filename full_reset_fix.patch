diff --git a/progAVR.c b/progAVR.c
index 1111111..2222222 100644
--- a/progAVR.c
+++ b/progAVR.c
@@ -120,6 +120,18 @@ int ReadAT(...)
     j=1;

+    // --- UNIVERSAL HARD RESET BEFORE READING AVR ---
+    bufferU[j++] = EXT_PORT;
+    bufferU[j++] = 0;      // MCLR=0
+    bufferU[j++] = 0;
+    bufferU[j++] = EN_VPP_VCC;
+    bufferU[j++] = 0x0;    // VDD off
+    bufferU[j++] = WAIT_T3;
+    bufferU[j++] = EXT_PORT;
+    bufferU[j++] = 0x08;   // MCLR=1
+    bufferU[j++] = 0;
+    bufferU[j++] = WAIT_T3;
+
     bufferU[j++] = SET_PARAMETER;
     bufferU[j++] = SET_T3;

